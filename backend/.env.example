# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hireiq?retryWrites=true&w=majority

# JWT Secret — any long random string
JWT_SECRET=your_super_secret_jwt_key_here

# URL of the deployed Python agents server (no trailing slash needed)
# Local: http://localhost:5001
# Vercel: https://your-agents-project.vercel.app
AGENT_URL=http://localhost:5001

# Server port (local only, optional, default is 5000; ignored on Vercel)
PORT=5000